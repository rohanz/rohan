---
import { blueprintEntryFor, defaultPathFor, swissPathFor } from '../lib/theme-paths';

const classicHref = defaultPathFor(Astro.url.pathname);
const blueprintHref = blueprintEntryFor(Astro.url.pathname);
---
<a
  class="transit-theme-switch sign-pill"
  href={classicHref}
  data-theme-pref="default"
  data-ride-ignore
>Classic Mode</a>
<a
  class="blueprint-theme-switch sign-pill"
  href={blueprintHref}
  data-theme-pref="blueprint"
  data-astro-reload
  data-astro-prefetch="false"
  data-ride-ignore
>Blueprint Mode</a>
<a class="swiss-theme-switch sign-pill" href={swissPathFor(Astro.url.pathname)} data-theme-pref="swiss" data-ride-ignore>Swiss Mode</a>
