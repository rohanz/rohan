---
import { blueprintEntryFor, transitPathFor } from '../lib/theme-paths';
// The unlisted accent gallery has no counterpart in the other themes.
const path = Astro.url.pathname.replace(/\/$/, '') === '/swatches' ? '/' : Astro.url.pathname;
---
<nav class="sw-themes" aria-label="Site themes">
  <span class="sw-label" aria-current="true">classic</span>
  <a class="sw-label sw-link" href={transitPathFor(path)} data-theme-pref="transit" data-astro-reload>transit</a>
  <a class="sw-label sw-link" href={blueprintEntryFor(path)} data-theme-pref="blueprint" data-astro-reload data-astro-prefetch="false">blueprint</a>
</nav>
