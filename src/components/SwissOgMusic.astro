---
// A deterministic still in the music page's scope / VU line language.
// This is an illustration, not a measurement of a particular recording.
const scope = Array.from({ length: 641 }, (_, i) => {
  const t = i / 640 * Math.PI * 8;
  const x = 300 + 111 * Math.sin(t) + 28 * Math.sin(t * 3.25);
  const y = 231 + 145 * Math.sin(t + .42) + 20 * Math.sin(t * 2.5);
  return `${i ? 'L' : 'M'}${x.toFixed(2)},${y.toFixed(2)}`;
}).join(' ');
const angle = (fraction: number) => Math.PI * (-.85 + fraction * .7);
const point = (fraction: number, radius: number) => {
  const a = angle(fraction);
  return `${(300 + Math.cos(a) * radius).toFixed(2)},${(591 + Math.sin(a) * radius).toFixed(2)}`;
};
---
<svg class="og-music-viz" viewBox="0 0 600 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <g stroke="currentColor" stroke-opacity=".22" stroke-width="1">
    <path d="M0 435H600 M0 231H600 M300 0V435 M69 0L504 435 M531 0L96 435 M0 399.5H600" />
    <path d={`M${point(0, 137)} A137 137 0 0 1 ${point(1, 137)}`} />
  </g>
  <path d={scope} stroke="var(--accent)" stroke-width="1.6" stroke-opacity=".85" />
  <path d="M442 399V435" stroke="var(--accent)" stroke-width="4" />
  <g stroke="currentColor" stroke-width="1.5">
    {Array.from({ length: 21 }, (_, i) => <path d={`M${point(i / 20, i % 5 === 0 ? 127 : 132)} L${point(i / 20, 142)}`} />)}
    <path d={`M300 591 L${point(.69, 125)}`} stroke-width="2.5" />
  </g>
  <path d={`M${point(.85, 137)} A137 137 0 0 1 ${point(1, 137)}`} stroke="var(--accent)" stroke-width="3" />
  <circle cx="300" cy="591" r="4" fill="currentColor" />
  <g fill="currentColor" font-family="General Sans, sans-serif" font-size="14" letter-spacing="2">
    <text x="48" y="42">STEREO</text><text x="48" y="477">VU</text>
    <text x="48" y="416">−1</text><text x="531" y="416">+1</text>
  </g>
</svg>
