---
// Every string on this page is shared with transit and/or blueprint, so all
// of it comes from src/data/ — see the header comment on each module for the
// full consumer list. Only the bento markup below is classic's own.
import { BIO_FULL, TAGLINE } from '../data/bio';
import { RESUME_FILENAME, RESUME_LABEL, RESUME_PATH } from '../data/resume';
import { BENTO_SOCIALS } from '../data/socials';
import { STATS } from '../data/stats';
import { TECH_STACK } from '../data/tech-stack';
import { TESTIMONIALS } from '../data/testimonials';
const ticker = 'music production • mixing & mastering • audio engineering • ai agents • llm fine-tuning • quant research • backtesting • trading systems • data pipelines • cloud infrastructure • web development • ui/ux design • creative coding • soldering • embedded systems • mobile apps • ableton live • ';
const testimonialLoop = Array.from({ length: 16 }, () => TESTIMONIALS).flat();
---
<div class="about-layout">
  <div class="bento-grid">
    <div class="bento-card bento-bio stagger-child">
      <h3 class="bento-label">bio</h3>
      <p class="bento-bio-text">{BIO_FULL}</p>
      <div class="bento-bio-links">
        {BENTO_SOCIALS.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="bento-social-link" aria-label={social.label}><i class={social.faIcon} aria-hidden="true"></i></a>
        ))}
      </div>
    </div>
    <div class="bento-card bento-photo stagger-child"><img src="/assets/images/profile.webp" alt="Rohan, smiling outdoors" class="bento-photo-img img-fade loaded" width="1000" height="1334" loading="lazy" decoding="async" /></div>
    <div class="bento-card bento-stats stagger-child">
      <h3 class="bento-label">stats</h3>
      <div class="bento-stats-grid">
        {STATS.map((stat) => <div class="stat-item"><span class="stat-number">{stat.value}</span><span class="stat-desc">{stat.label}</span></div>)}
      </div>
    </div>
    <div class="bento-card bento-tech stagger-child">
      <h3 class="bento-label">tech stack</h3>
      <div class="bento-tech-icons">
        {TECH_STACK.map((tech) => (
          <span class="tech-icon" title={tech.label}>
            {tech.icon.kind === 'fa'
              ? <i class={tech.icon.className} aria-hidden="true"></i>
              : <svg class="tech-svg" viewBox={tech.icon.viewBox} fill="currentColor" aria-hidden="true"><path d={tech.icon.path} /></svg>}
            <span class="tech-label">{tech.label}</span>
          </span>
        ))}
      </div>
    </div>
    <div class="bento-card bento-cv stagger-child">
      <h3 class="bento-label">resume</h3>
      <a href={RESUME_PATH} class="cv-download" download={RESUME_FILENAME}><i class="fas fa-download" aria-hidden="true"></i> {RESUME_LABEL}</a>
      <p class="bento-cv-sub">{TAGLINE}</p>
    </div>
    <div class="bento-card bento-marquee stagger-child"><div class="marquee-track"><span class="marquee-content">{ticker}</span><span class="marquee-content">{ticker}</span></div></div>
  </div>
  <div class="scrolling-testimonials stagger-child">
    <div class="testimonials-scroll-container" style={`animation-duration:${testimonialLoop.length * 4}s`}>
      {testimonialLoop.map(({ quote, author }) => <div class="scroll-testimonial"><div class="scroll-quote">“{quote}”</div><div class="scroll-author">— {author}</div></div>)}
    </div>
  </div>
</div>
