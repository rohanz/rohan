---
// GoatCounter (rohan140.goatcounter.com). no_onload: the ClientRouter swaps
// pages without full loads, so auto-counting would log only the first page —
// count the initial document immediately and each ClientRouter page load.
// GoatCounter ignores localhost by itself, so dev browsing never counts.
// Events: goatcounter.count({ path: 'name', event: true }) — wired for the
// signals Rohan cares about (theme switches, resume download, music plays).
---
<script is:inline>
  window.goatcounter ??= { no_onload: true };
</script>
<script is:inline data-goatcounter="https://rohan140.goatcounter.com/count" async src="//gc.zgo.at/count.js" onload="document.dispatchEvent(new Event('goatcounter:ready'))"></script>
<script>
  type GcOpts = { path: string; event?: boolean };
  declare global {
    interface Window {
      goatcounter?: { no_onload?: boolean; count?: (opts: GcOpts) => void };
    }
  }

  const pending: GcOpts[] = [];
  const flush = () => {
    const gc = window.goatcounter;
    if (typeof gc?.count !== 'function') return;
    for (const opts of pending.splice(0)) gc.count(opts);
  };
  const count = (opts: GcOpts) => {
    pending.push(opts);
    flush();
  };
  document.addEventListener('goatcounter:ready', flush);

  // The initial window load can arrive after a client navigation when the SDK
  // is slow. Count each document once, including before that first load event.
  let countedBody: HTMLElement | undefined;
  const countPage = () => {
    if (countedBody === document.body) return;
    countedBody = document.body;
    count({ path: location.pathname });
  };
  countPage();
  document.addEventListener('astro:page-load', countPage);

  // Delegated events survive router swaps without rebinding per page.
  document.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target : null;
    if (!t) return;
    if (t.closest('[data-theme-pref="blueprint"]')) count({ path: 'switch-to-blueprint', event: true });
    else if (t.closest('[data-theme-pref="transit"]')) count({ path: 'switch-to-transit', event: true });
    else if (t.closest('[data-theme-pref="default"], .transit-theme-switch')) count({ path: 'switch-to-classic', event: true });
    else if (t.closest('a[href$="resume.pdf"]')) count({ path: 'resume-download', event: true });
    else if (t.closest('a[download]')) count({ path: 'file-download', event: true });
  });

  // First play per page visit, per player. Shared players attach to the DOM
  // and clear gcCounted before a route swap so returning starts a new visit.
  document.addEventListener('play', (e) => {
    const el = e.target;
    if (el instanceof HTMLMediaElement && !el.dataset.gcCounted) {
      el.dataset.gcCounted = '1';
      count({ path: 'audio-play', event: true });
    }
  }, true);
</script>
