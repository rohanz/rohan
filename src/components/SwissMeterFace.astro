---
// The static face of one music meter: grids, axes and the VU face. Rendered in
// the page so it paints with the first frame and follows the row's colour
// tokens through hover and playback; the canvas above draws only live signal.
// A VU meter is all face: music-viz.ts rotates its needle (--vu-needle on the
// cell) and lights its lamp. The drawing scales with the cell's width; the
// labels keep their size and ride on it (see vu-face.ts).
import { VU_BOX, vuFace } from '../lib/visuals/vu-face';

interface Props { kind: 'wave' | 'freq' | 'stereo' | 'vu'; channel?: 'L' | 'R' }
const { kind, channel = 'L' } = Astro.props;
const vu = kind === 'vu' ? vuFace() : null;
const at = (l: { left: number; top: number; dx: number; dy: number }) => `left:${l.left}%;top:${l.top}%;--dx:${l.dx}px;--dy:${l.dy}px`;
---
<div class="sw-meter-face" aria-hidden="true">
  {(kind === 'wave' || kind === 'stereo') && <i class="sw-face-line sw-face-h"></i>}
  {kind === 'stereo' && (
    <>
      <i class="sw-face-line sw-face-v"></i>
      <i class="sw-face-line sw-face-corr"></i>
      {/* L/R axes at 45 degrees, as on a goniometer: a square as tall as the
          cell, centred, so the diagonals run top to bottom. */}
      <svg class="sw-face-x" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 0L100 100M0 100L100 0" vector-effect="non-scaling-stroke" />
      </svg>
    </>
  )}
  {vu && (
    <>
      <div class="sw-vu">
        <svg viewBox={`0 0 ${VU_BOX.width} ${VU_BOX.height}`}>
          <path class="sw-vu-mark" d={vu.arc} />
          <path class="sw-vu-hot sw-vu-zone" d={vu.hotArc} />
          {vu.ticks.map((t) => (
            <line class={t.kind === 'hot' ? 'sw-vu-hot' : t.kind === 'major' ? 'sw-vu-mark' : 'sw-vu-minor'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
          ))}
          <g transform={`translate(${vu.pivot.x} ${vu.pivot.y})`}>
            <line class="sw-vu-needle" x1="0" y1="0" x2="0" y2={-vu.needleLength} />
          </g>
        </svg>
        {vu.numbers.map((n) => <span class:list={['sw-vu-num', { 'is-hot': n.hot, 'is-fine': n.fine }]} style={at(n)}>{n.text}</span>)}
        <span class="sw-vu-sign" style={at(vu.minus)}>−</span>
        <span class="sw-vu-sign is-hot" style={at(vu.plus)}>+</span>
      </div>
      <span class="sw-vu-tag">VU</span>
      <span class="sw-vu-channel">{channel}</span>
      <i class="sw-vu-lamp"></i>
    </>
  )}
</div>
