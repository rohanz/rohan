---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import { getProjectNav, type NavItem } from '../../../lib/projectNav';
import { projectOgImage } from '../../../lib/project-og';
import { lineById } from '../../../data/system';
import { drawingFor, headerViewBoxFor } from '../../../lib/swiss/drawings';
import { linkAttrs, projectLinks } from '../../../lib/project-links';
import '../../../styles/widget-base.css';
import '../../../styles/bqst-widgets.css';
import '../../../styles/chord-monitor.css';
import '../../../styles/qla-widgets.css';
import '../../../styles/qlf-widgets.css';
import '../../../styles/demo-player.css';
import '../../../styles/qla2-widgets.css';
import '../../../styles/qls-widgets.css';
import '../../../styles/mle-replay.css';
import '../../../styles/room-run.css';
import '../../../styles/transit-widgets.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  // Unlisted projects still get a built page, but they don't participate in
  // the prev/next chain: `ordered` (which drives getProjectNav) holds listed
  // entries only, so an unlisted page shows no prev/next and no listed page
  // ever links to it.
  const ordered = projects
    .filter((p) => !p.data.unlisted)
    .map((p) => ({ slug: p.id, title: p.data.title })) as NavItem[];
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, ordered },
  }));
}

const { project, ordered } = Astro.props;
const { Content, headings } = await render(project);
const { prev, next } = getProjectNav(ordered, project.id);
const line = lineById('projects');
const Drawing = drawingFor(project.id);
// TOC covers h2/h3 of the article body only — no h1/title, and nothing
// before the first h2 (a leading h3 would float above the line's first stop).
const h2h3 = headings.filter((h) => h.depth === 2 || h.depth === 3);
const firstH2 = h2h3.findIndex((h) => h.depth === 2);
const sections = firstH2 === -1 ? [] : h2h3.slice(firstH2);
---
<PageLayout
  title={`${project.data.barTitle ? `${project.data.barTitle} · ` : ''}${project.data.title} - rohan.jk`}
  description={project.data.summary}
  lineId="projects"
  hex={line.hex}
  signName={project.data.barTitle ?? project.data.title}
  ogImage={projectOgImage(project.id)}
>
  <div class="article-layout">
    {sections.length > 0 && (
      <nav class="train-toc" aria-label="section navigation">
        <div class="toc-inner">
          <svg class="toc-rail" aria-hidden="true"></svg>
          <ol>
            {sections.map((h) => (
              <li class={h.depth === 3 ? 'sub' : ''} data-depth={h.depth}>
                <a href={`#${h.slug}`} data-target={h.slug}>
                  <span class="toc-label">{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="toc-nav">
          {prev ? (
            <a class="toc-nav-link toc-nav-prev" href={`/transit/projects/${prev.slug}`}><span class="nav-arrow">‹</span>prev</a>
          ) : (
            <span class="toc-nav-link toc-nav-prev is-disabled" aria-disabled="true"><span class="nav-arrow">‹</span>prev</span>
          )}
          <a class="toc-nav-link" href="/transit/projects">all projects</a>
          {next ? (
            <a class="toc-nav-link toc-nav-next" href={`/transit/projects/${next.slug}`}>next<span class="nav-arrow">›</span></a>
          ) : (
            <span class="toc-nav-link toc-nav-next is-disabled" aria-disabled="true">next<span class="nav-arrow">›</span></span>
          )}
        </div>
      </nav>
    )}

    <article class="article">
      {/* The project's drawing, played once on arrival (see play-drawing.ts).
           Decorative: the title below names the project. `swiss-card` is the
           hook the drawing's own hover rules key on. */}
      {Drawing && (
        <div class="swiss-card article-drawing" aria-hidden="true">
          <Drawing viewBox={headerViewBoxFor(project.id)} />
        </div>
      )}
      <header class="article-header">
        <h1 class="article-title">{project.data.title}</h1>
        <p class="article-summary">{project.data.summary}</p>
        {project.data.links.length > 0 && <div class="download-actions article-links">{projectLinks(project.data.links).map((link) => <a {...linkAttrs(link)}>{link.label}</a>)}</div>}
      </header>
      <Content />

      <nav class="stop-nav" aria-label="project navigation">
        {prev ? <a class="prev" href={`/transit/projects/${prev.slug}`}>← previous stop<span>{prev.title}</span></a> : <span></span>}
        <a class="to-line" href="/transit/projects">back to projects</a>
        {next ? <a class="next" href={`/transit/projects/${next.slug}`}>next stop →<span>{next.title}</span></a> : <span></span>}
      </nav>
    </article>
  </div>
</PageLayout>

<script>
  import '../../../scripts/article.ts';
  import '../../../scripts/article-widgets.ts';
  import { playDrawingOnArrival } from '../../../lib/swiss/play-drawing';

  let stopDrawing: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    stopDrawing?.();
    const art = document.querySelector<HTMLElement>('.article-drawing');
    stopDrawing = art ? playDrawingOnArrival(art) : undefined;
  });
  document.addEventListener('astro:before-swap', () => { stopDrawing?.(); stopDrawing = undefined; });
</script>

<style>
  .article-layout { position: relative; display: grid; grid-template-columns: 1fr; justify-items: center; }
  /* Reading column + body size match the original site's detail page exactly:
     an 800px column (matches classic mode — Rohan re-widened 2026-07-14 after a 760 interlude) with 1.25rem (20px) / 1.7 body text. Headings/title/summary
     set their own sizes below, so only paragraphs & lists inherit this. */
  .article { max-width: 800px; width: 100%; min-width: 0; font-size: 1.25rem; line-height: 1.7; }
  /* Geometry replicated from the ORIGINAL site's detail view (--detail-half):
     the article column is VIEWPORT-centred once the viewport is wide enough,
     and the TOC floats centred in the gutter between the destinations rail
     and the article — equal air on both of its sides (--half = half the free
     space between the rail and a viewport-centred 800px article, after the
     212px TOC). When the viewport is too narrow to centre (--half negative;
     with a 300px rail that's everything below ~2080px) the max() clamps take
     over exactly like the original's: the TOC sits one content-pad (--cpad,
     3.5vw — the original's gutter token) right of the rail and the article
     clears the TOC column by 4rem — the original's measured 64.0px gap at
     both 1440 and 1280 (its .detail-content-column margin-left reserves
     `210px + 4rem` past the fixed TOC). The max() against the pure centred
     position (50vw - 400px) is also the rail-collision guard: the article's
     left edge can never fall below rail + cpad + toc width + 4rem, so the centred
     column can't slide under the rail. */
  .article-layout {
    /* 248px column = a 216px label measure at the 1.15rem type, so all but
       the longest section titles hold ONE line (the original's measure is
       194px — anything that wraps here wraps there too). */
    --toc-w: 248px;
    --cpad: clamp(1.5rem, 3.5vw, 4rem);
    --half: calc((50vw - var(--rail-w, 0px) - var(--toc-w) - 400px) / 2);
    /* One shared gutter on BOTH sides of the TOC (rail→TOC and TOC→article are
       always equal — Rohan's laptop-round call, replacing the fixed 4rem body
       gap). --half is exactly the gutter that puts an 800px article at the
       viewport centre, so wide screens keep the centred column; when that
       would squeeze below --cpad (laptops), the article slides left toward
       the TOC instead and the two gutters stay symmetric. */
    --gutter: max(var(--cpad), var(--half));
    /* The article's LEFT EDGE tracks the CLASSIC theme's article exactly
       (Rohan's call 2026-07-14): same centring floor as classic's
       sidebar(400) + content-pad + toc(210) + 4rem, so the reading column
       sits at the identical x in both themes at every width — switching
       modes never shifts the text. The TOC then centres in whatever gutter
       remains (the symmetric-air rule, preserved by construction). */
    --classic-floor: calc(clamp(250px, 21vw, 400px) + clamp(1.5rem, 3.5vw, 4rem) + 210px + 4rem);
    --article-left: max(calc(50vw - 400px), var(--classic-floor), calc(var(--rail-w, 0px) + 2 * var(--cpad) + var(--toc-w)));
    --toc-left: calc(var(--rail-w, 0px) + (var(--article-left) - var(--rail-w, 0px) - var(--toc-w)) / 2);
  }
  @media (min-width: 1000px) {
    .article-layout { justify-items: start; }
    .article {
      /* --article-left is a viewport coordinate; the page-body is uncapped on
         detail pages (see the :has() rule in the global block) so it starts
         at x=0 — subtract only its own left padding to get the margin. */
      margin-left: calc(var(--article-left) - clamp(1rem, 4vw, 3rem));
      max-width: min(800px, calc(100vw - var(--article-left) - 2.5rem));
    }
  }

  /* The drawing panel: a white card like the map's project cards, ink lines,
     the projects line's red as the drawing's one accent. The fixed ratio
     reserves the box before paint; the SVG is inline, so nothing loads late.
     Top margin 1.5rem keeps the panel's top edge where the TOC rail starts
     (--transit-toc-top below). Drawing labels take the page's face rather
     than General Sans, which transit doesn't load. */
  .article-drawing {
    --accent: var(--line-projects);
    --card-surface: #fff;
    color: var(--ink);
    background: var(--card-surface);
    border: 1px solid rgba(26, 26, 26, 0.12);
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0 2rem;
  }
  .article-drawing :global(svg) { display: block; width: 100%; height: 100%; }
  .article-drawing :global(text) { font-family: inherit; }

  /* Title + blurb under the drawing (mirrors the original site's detail header:
     a large accent-coloured title, then an italic dimmed summary). The coloured
     sign-header bar now carries only the short barTitle label. */
  .article-header { margin: 0 0 2.4rem; }
  .article-links { margin-top: 1.75rem; }
  /* With buttons, the header ends on them: pull the first heading up so the
     gap below the buttons matches the one above (margins collapse to the max). */
  .article-header:has(.article-links) { margin-bottom: 1.75rem; }
  .article-header:has(.article-links) + :global(h2) { margin-top: 1.75rem; }
  .article-links a { margin: 0; }
  /* The header's link colour would otherwise win over the buttons' own colours. */
  .article-links a.try-it-btn { color: #fff; }
  .article-links a.support-btn { color: var(--line-projects); }
  .article-links a.support-btn:hover { color: #fff; }
  .article-title {
    font-size: 2.2rem; font-weight: 800; line-height: 1.15;
    color: var(--line-projects); margin: 0 0 0.75rem;
  }
  .article-summary {
    font-size: 1.2rem; font-weight: 500; font-style: italic;
    line-height: 1.6; color: var(--muted); margin: 0;
  }
  @media (max-width: 560px) { .article-title { font-size: 1.8rem; } }

  /* Heading sizes match the original site's detail body exactly. */
  .article :global(h2) { font-size: clamp(1.45rem, 2.6vw, 2rem); font-weight: 750; margin-top: 2.4rem; scroll-margin-top: 90px; }
  .article :global(h3) { font-size: clamp(1.12rem, 1.8vw, 1.35rem); font-weight: 700; margin-top: 1.6rem; }
  /* Images: centred, not left-aligned. Ones narrower than the column keep their
     natural size and sit centred; wide ones cap at the column width. */
  .article :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border-radius: var(--radius);
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    cursor: zoom-in;
  }
  /* Code blocks WRAP to the column instead of scrolling horizontally (matches the
     original site — long lines fold rather than forcing a scrollbar). */
  .article :global(pre) { max-width: 100%; box-sizing: border-box; overflow-x: auto; }
  .article :global(pre code) { white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }

  /* ------------------------------------------------------------
     Article body images — intrinsic-size reservation
     ------------------------------------------------------------
     Transit renders the same markdown, and the same missing width/height
     attributes cost it ~1,000px of growth per article load. Same remedy,
     same numbers as the classic theme — src/styles/default.css holds the
     canonical list and the note about keeping the two in sync. No
     max-width here: transit has no portrait-image cap. */
.article :global(img[src*="bqst/final-ui.webp"]) { aspect-ratio: 1344 / 1376; }
  .article :global(img[src*="bqst/prototype-ui.webp"]) { aspect-ratio: 1028 / 664; }
  .article :global(img[src*="bqst/asset-knob-large.webp"]) { aspect-ratio: 1600 / 1600; }
  .article :global(img[src*="bqst/asset-knob-small.webp"]) { aspect-ratio: 1600 / 1600; }
  .article :global(img[src*="bqst/asset-vu-meter.webp"]) { aspect-ratio: 1600 / 1600; }
  .article :global(img[src*="careersphere/architecture.webp"]) { aspect-ratio: 1720 / 1000; }
  .article :global(img[src*="careersphere/how-to-get-there.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="careersphere/onboarding.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="careersphere/pycon-results.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="careersphere/sphere.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="careersphere/where-you-could-go.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="careersphere/where-you-stand.webp"]) { aspect-ratio: 3024 / 1670; }
  .article :global(img[src*="datacenter/architecture.webp"]) { aspect-ratio: 291 / 892; }
  .article :global(img[src*="datacenter/screenshot-complete.webp"]) { aspect-ratio: 502 / 549; }
  .article :global(img[src*="datacenter/screenshot-sources.webp"]) { aspect-ratio: 566 / 409; }
  .article :global(img[src*="datacenter/screenshot-news.webp"]) { aspect-ratio: 530 / 299; }
  .article :global(img[src*="datacenter/screenshot-agent.webp"]) { aspect-ratio: 709 / 317; }
  .article :global(img[src*="live-chord-monitor/app-ui.webp"]) { aspect-ratio: 1248 / 848; }
  .article :global(img[src*="patent/screenshot-tracking.webp"]) { aspect-ratio: 540 / 1170; }
  .article :global(img[src*="patent/screenshot-dashboard.webp"]) { aspect-ratio: 540 / 1170; }
  .article :global(img[src*="patent/screenshot-similarity.webp"]) { aspect-ratio: 540 / 1170; }
  .article :global(img[src*="tesla/changelog.webp"]) { aspect-ratio: 571 / 432; }
  .article :global(img[src*="website/mobile-view.webp"]) { aspect-ratio: 434 / 935; }
  .article :global(img[src*="yourcast/architecture.webp"]) { aspect-ratio: 1600 / 1187; }
  .article :global(img[src*="yourcast/screenshot-landing.webp"]) { aspect-ratio: 1170 / 2532; }
  .article :global(img[src*="yourcast/screenshot-personalize.webp"]) { aspect-ratio: 1170 / 2532; }
  .article :global(img[src*="yourcast/screenshot-player.webp"]) { aspect-ratio: 1170 / 2532; }

  /* ------------------------------------------------------------
     Article widget placeholders — space reservation
     ------------------------------------------------------------
     Same mechanism (and same fix) as the classic theme: the interactive
     figures are empty <div>s in the shared markdown that article-widgets.ts
     fills ~700ms after first paint, so .article grew ~2,500px under the
     reader on every transit article load.

     Heights are measured at desktop width (1280px viewport, 602px article
     column) and differ slightly from the classic numbers because the column
     is 2px narrower. The `:empty` guard releases the reservation the instant
     a script inserts its first child, so an imperfect estimate costs a few px
     of settle instead of leaving permanent dead space — and a widget whose
     script never runs holds its place rather than collapsing. */
  .article :global(#bqst-eq-visual:empty) { min-height: 464px; }
  .article :global(#bqst-transfer-visual:empty) { min-height: 453px; }
  .article :global(#bqst-harmonics-visual:empty) { min-height: 453px; }
  .article :global(#bqst-oversampling-visual:empty) { min-height: 454px; }
  .article :global(#bqst-audio-demo:empty) { min-height: 227px; }
  .article :global(#qla-compound-visual:empty) { min-height: 430px; }
  .article :global(#qla-gate-visual:empty) { min-height: 762px; }
  .article :global(#qla-judge-visual:empty) { min-height: 1253px; }
  .article :global(#qla-quant-visual:empty) { min-height: 486px; }
  .article :global(#qla-roster-visual:empty) { min-height: 803px; }
  .article :global(#qlf-lookahead-visual:empty) { min-height: 703px; }
  .article :global(#qlf-kalman-visual:empty) { min-height: 487px; }
  .article :global(#qlf-survivorship-visual:empty) { min-height: 606px; }
  .article :global(#qlf-risk-visual:empty) { min-height: 784px; }
  .article :global(#lcm-demo:empty) { min-height: 346px; }
  .article :global(a:not(.try-it-btn):not(.support-btn)) { color: var(--line-projects); }
  .article :global(table) { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.92rem; }
  .article :global(th), .article :global(td) { border: 1px solid rgba(0,0,0,0.12); padding: 0.5rem 0.7rem; text-align: left; }

  /* Train-line table of contents. The rail is one octilinear SVG path in the
     line color (drawn by src/scripts/article.ts after layout): it runs
     vertically past the h2 ticks, jogs 18px right at 45° for h3 runs, and
     steps back out when h2s resume — like the map's route geometry. Ticks are
     SVG circles on the path; the current one's fill transitions white→amber
     flush against the ink ring (SVG fill meets the stroke's inner edge, so
     there is no white sliver). Active state changes fill/color only — never a
     layout property — so passing a section never nudges the rail. */
  .train-toc { display: none; }
  @media (min-width: 1000px) {
    .train-toc {
      /* A full-height flex column: the section list sits at the top and the
         prev/all-projects/next nav is pinned to the BOTTOM (margin-top:auto), so
         it holds a fixed spot on screen regardless of the TOC's length — like the
         original site's sidebar. */
      display: flex;
      flex-direction: column;
      position: fixed;
      /* The rail's top edge IS the drawing panel's top edge. article.ts
         measures that and writes it back; this resting value used to be a
         rough 11rem — 38px too low — so the rail visibly jumped up on every
         article load once the measurement landed.

         The offset is entirely static, so it is derived rather than guessed:
         the sign-header is 74px tall, .page-body adds 40px of top padding, and
         .article-drawing has a 1.5rem top margin. 74 + 40 + 24 = 138px,
         constant at every viewport width — verified at 1024/1280/1440/1920/
         2560. article.ts now measures the same number, so its write is a
         no-op on load and the rail never moves.

         If the header height or page padding ever changes, the
         `transit TOC never repositions` case in e2e/layout-shift.spec.ts
         fails and this value needs updating with it. */
      --transit-toc-top: calc(74px + 40px + 1.5rem);
      top: var(--transit-toc-top);
      /* End the rail a small fixed margin above the viewport bottom so the
         prev/next nav (pinned to the bottom via margin-top:auto) holds ONE fixed
         spot regardless of the TOC's length — it never shifts when you page
         between projects — while sitting low enough to leave the section list
         maximum room on short screens. */
      bottom: 2.5rem;
      /* Centred in the rail↔article gutter (or a content-pad off the rail
         when the gutter is tight) — computed on .article-layout, inherited
         here. Viewport coordinate, matching this element's fixed positioning. */
      left: var(--toc-left);
      width: var(--toc-w, 248px);
      z-index: 5;
    }
  }
  .train-toc .toc-inner { position: relative; flex: 0 1 auto; min-height: 0; overflow-y: auto; scrollbar-width: none; }
  /* Scroll affordance for short screens: when the list overflows (article.ts
     toggles .is-scrollable), fade its bottom edge so it reads as "more below"
     instead of cut off mid-item. Fade lifts once scrolled to the end via the
     mask staying put — the last item scrolls up out of the faded band. */
  .train-toc .toc-inner.is-scrollable {
    mask-image: linear-gradient(to bottom, black calc(100% - 26px), transparent);
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 26px), transparent);
  }
  .train-toc .toc-inner::-webkit-scrollbar { display: none; }
  .train-toc :global(.toc-rail) { position: absolute; top: 0; left: 0; width: 44px; pointer-events: none; }
  .train-toc :global(.toc-rail path) {
    fill: none; stroke: var(--line-projects); stroke-width: 3.2;
    stroke-linejoin: round; stroke-linecap: round; opacity: 0.9;
  }
  .train-toc :global(.toc-rail circle) {
    fill: #fff; stroke: var(--ink); cursor: pointer; pointer-events: auto;
    transition: fill 0.45s ease;
  }
  .train-toc :global(.toc-rail circle.is-current) { fill: #f9c25e; }
  .train-toc ol { list-style: none; margin: 0; padding: 0.4rem 0; position: relative; }
  /* Type mirrors the ORIGINAL site's sidebar exactly: h2 links 1.15rem,
     h3 (sub) links 0.95rem, weight 600 — compact through spacing, not tiny type. */
  .train-toc li { position: relative; margin: 0 0 0.85rem; }
  .train-toc li:last-child { margin-bottom: 0; }
  .train-toc a {
    display: block; text-decoration: none; color: var(--muted);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.15rem; font-weight: 600; line-height: 1.2;
    padding-left: 32px;
  }
  .train-toc li.sub a { font-size: 0.95rem; padding-left: 48px; }
  .train-toc a:hover .toc-label { color: var(--ink); }
  .train-toc a.is-current .toc-label { color: var(--ink); }
  /* Parent h2 stays inked while one of its h3s is current (original's
     parent-active), keeping the section context visible in the rail. */
  .train-toc a.is-parent .toc-label { color: var(--ink); }

  /* Prev / all projects / next, in the left rail (desktop) — mirrors the original
     site's minimal sidebar nav (three lowercase links, dimmed until hover). The
     bottom .stop-nav is hidden on desktop and kept only for narrow screens where
     the rail itself is hidden. */
  /* Spacing/positioning mirror the CLASSIC theme's sidebar nav (Rohan's call
     2026-07-14): roomier rows via per-link vertical padding, links rest dimmed
     and wake on hover, 2rem bottom padding — the two modes' nav read the same. */
  .toc-nav {
    margin-top: auto;
    padding-top: 1.2rem;
    padding-bottom: 2rem;
    /* Same hairline the bottom .stop-nav uses; mirrors the classic theme's
       divider between the TOC and this nav. */
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    /* No left padding here — each link already gets 32px from `.train-toc a`, so
       adding more would push the nav 32px right of the TOC labels (misaligned). */
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  /* Match the TOC section links exactly (size/weight/colour come from .train-toc a);
     no extra dimming, so the nav reads as the same family, just lowercased. */
  .toc-nav-link {
    position: relative;
    text-decoration: none;
    text-transform: lowercase;
    padding: 0.4rem 0;
    opacity: 0.5;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  /* Darken to ink on hover, exactly like a TOC section link. Scoped under
     `.train-toc a` so it out-specifies the base `.train-toc a { color: muted }`
     rule (which includes the `a` element selector and would otherwise win). */
  .train-toc a.toc-nav-link:hover { color: var(--ink); opacity: 1; }
  /* Endpoint prev/next render as spans, so they miss the `.train-toc a`
     typography rules — replicate them, then dim to the classic theme's
     disabled level. pointer-events guards against any hover styling. */
