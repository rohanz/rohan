---
import SwissLayout from '../../../layouts/SwissLayout.astro';
import { getCollection, render } from 'astro:content';
import { getProjectNav, type NavItem } from '../../../lib/projectNav';
import { cardTextFor } from '../../../lib/swiss/card-text';
import { drawingFor } from '../../../lib/swiss/drawings';
import '../../../styles/swiss-cards.css';
import '../../../styles/swiss-article.css';
import '../../../styles/swiss-widgets.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const ordered = projects
    .filter((p) => !p.data.unlisted)
    .map((p) => ({ slug: p.id, title: p.data.title })) as NavItem[];
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, ordered } }));
}

const { project, ordered } = Astro.props;
const { Content, headings } = await render(project);
const { prev, next } = getProjectNav(ordered, project.id);
const word = cardTextFor(project.id);
const Drawing = drawingFor(project.id);
const h2h3 = headings.filter((h) => h.depth === 2 || h.depth === 3);
const firstH2 = h2h3.findIndex((h) => h.depth === 2);
const sections = firstH2 === -1 ? [] : h2h3.slice(firstH2);
---
<SwissLayout title={`${project.data.title} — rohan.jk`} description={project.data.summary} section="projects" ogImage={`/assets/images/og/${project.id}.png`}>
  <header class="sw-article-head">
    <div class="sw-article-head-inner">
      <div class="sw-article-head-title">
        <a class="sw-label sw-link" href="/swiss/projects">projects</a>
        <h1 class="sw-article-word">{word ?? project.data.title}</h1>
        {word && <p class="sw-article-title">{project.data.title}</p>}
        <p class="sw-article-summary">{project.data.summary}</p>
        <div class="sw-article-meta">{project.data.technologies.map((t) => <span class="sw-label">{t}</span>)}</div>
      </div>
      <div class="swiss-card sw-article-art" aria-hidden="true">
        <div class="swiss-card-art">
          {Drawing ? <Drawing /> : <div class="swiss-card-placeholder"></div>}
        </div>
      </div>
    </div>
  </header>
  <div class="sw-wrap sw-article-layout">
    <nav class="sw-toc train-toc" aria-label="section navigation">
      {sections.length > 0 && (
        <div class="toc-inner">
        <ol>
          {sections.map((h) => (
            <li class={h.depth === 3 ? 'sub' : ''} data-depth={h.depth}>
              <a href={`#${h.slug}`} data-target={h.slug}><span class="toc-label">{h.text}</span></a>
            </li>
          ))}
        </ol>
        </div>
      )}
      <div class="sw-toc-nav">
        {prev && <a class="sw-label sw-link" href={`/swiss/projects/${prev.slug}`}>← prev</a>}
        {next && <a class="sw-label sw-link" href={`/swiss/projects/${next.slug}`}>next →</a>}
        <a class="sw-label sw-link sw-toc-all" href="/swiss/projects">all projects</a>
      </div>
    </nav>
    <article class="article">
      <Content />
      <nav class="sw-article-foot" aria-label="project navigation">
        <div class="sw-article-foot-cells">
          {prev ? <a class="prev" href={`/swiss/projects/${prev.slug}`}><span class="sw-label">← previous</span><span class="sw-article-foot-title">{prev.title}</span></a> : <div aria-hidden="true"></div>}
          {next ? <a class="next" href={`/swiss/projects/${next.slug}`}><span class="sw-label">next →</span><span class="sw-article-foot-title">{next.title}</span></a> : <div aria-hidden="true"></div>}
        </div>
        <a class="sw-article-all sw-label sw-link" href="/swiss/projects">all projects</a>
      </nav>
    </article>
  </div>
  <script>
    import '../../../scripts/article.ts';
    import '../../../scripts/article-widgets.ts';

    let cleanupArt: (() => void) | undefined;
    function initArt() {
      cleanupArt?.();
      const art = document.querySelector<HTMLElement>('.sw-article-art');
      if (!art) return;
      const start = window.setTimeout(() => art.classList.add('is-hover'), 500);
      const stop = window.setTimeout(() => {
        if (!art.matches(':hover')) art.classList.remove('is-hover');
      }, 3000);
      const enter = () => art.classList.add('is-hover');
      const leave = () => {
        window.clearTimeout(start);
        art.classList.remove('is-hover');
      };
      art.addEventListener('pointerenter', enter);
      art.addEventListener('pointerleave', leave);
      cleanupArt = () => {
        window.clearTimeout(start);
        window.clearTimeout(stop);
        art.removeEventListener('pointerenter', enter);
        art.removeEventListener('pointerleave', leave);
        art.classList.remove('is-hover');
      };
    }
    document.addEventListener('astro:page-load', initArt);
    document.addEventListener('astro:before-swap', () => { cleanupArt?.(); cleanupArt = undefined; });
  </script>
</SwissLayout>
