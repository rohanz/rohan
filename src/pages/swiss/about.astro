---
import '../../styles/swiss-about.css';
import SwissLayout from '../../layouts/SwissLayout.astro';
import { BIO_INTRO, BIO_WORK, BIO_MUSIC, TAGLINE } from '../../data/bio';
import { ABOUT_DESCRIPTION } from '../../data/page-meta';
import { RESUME_FILENAME, RESUME_LABEL, RESUME_PATH } from '../../data/resume';
import { SOCIALS } from '../../data/socials';
import { STATS } from '../../data/stats';
import { TECH_STACK } from '../../data/tech-stack';
import { TESTIMONIALS } from '../../data/testimonials';
---
<SwissLayout title="about — rohan.jk" description={ABOUT_DESCRIPTION} section="about">
  <section class="sw-wrap sw-section sw-about">
    <div class="sw-grid sw-about-spread">
      <div class="sw-about-copy">
        <div class="sw-about-lead">
          <p class="sw-label" data-reveal="block">{TAGLINE}</p>
          <h1 class="sw-display sw-display-md" data-reveal="lines">{BIO_INTRO}</h1>
        </div>
        <div class="sw-about-body" data-reveal="block">
          <p>{BIO_WORK}</p>
          <p>{BIO_MUSIC}</p>
          <div class="sw-about-links">
            {SOCIALS.map((s) => <a class="sw-label sw-link-ext" href={s.href} target="_blank" rel="noopener noreferrer">{s.label.toLowerCase()} <span class="sw-arrow" aria-hidden="true">↗</span></a>)}
          </div>
          <p class="sw-about-resume"><a class="sw-label sw-link-ext" href={RESUME_PATH} download={RESUME_FILENAME}>{RESUME_LABEL} <span class="sw-arrow" aria-hidden="true">↗</span></a></p>
        </div>
      </div>
      <figure class="sw-about-photo">
        <img src="/assets/images/profile.webp" alt="Rohan outdoors" width="1000" height="1334" loading="eager" decoding="async" />
      </figure>
    </div>
    <hr class="sw-rule" />
    <div class="sw-grid sw-about-facts">
      <div class="sw-about-stats" data-reveal-group>
        {STATS.map((s) => <div class="sw-stat" data-reveal="block"><span class="sw-display sw-display-md">{s.value}</span><span class="sw-label">{s.label}</span></div>)}
      </div>
      <div class="sw-about-tech" data-reveal="block">
        <span class="sw-label">tech stack</span>
        <p class="sw-tech-list">{TECH_STACK.map((t) => t.name).join(' · ')}</p>
      </div>
    </div>
    <section class="sw-about-testimonials" data-testimonials aria-label="Testimonials" aria-roledescription="carousel">
      <h2 class="sw-label">a few words from friends &amp; family</h2>
      <div class="sw-about-quotes" id="sw-testimonial-quotes" aria-live="polite" aria-atomic="true">
        {TESTIMONIALS.map((t, i) => <blockquote class="sw-quote" data-testimonial hidden={i !== 0} aria-hidden={i !== 0 ? 'true' : 'false'}><p>“{t.quote}”</p><footer class="sw-label">{t.author}</footer></blockquote>)}
      </div>
      <div class="sw-testimonial-controls" data-testimonial-controls hidden>
        <button class="sw-testimonial-arrow" type="button" data-testimonial-prev aria-label="Previous testimonial" aria-controls="sw-testimonial-quotes">←</button>
        <div class="sw-testimonial-dots" aria-label="Choose a testimonial">
          {TESTIMONIALS.map((t, i) => <button class="sw-testimonial-dot" type="button" data-testimonial-dot aria-label={`Show testimonial by ${t.author}`} aria-current={i === 0 ? 'true' : undefined} aria-controls="sw-testimonial-quotes"><span aria-hidden="true"></span></button>)}
        </div>
        <button class="sw-testimonial-arrow" type="button" data-testimonial-next aria-label="Next testimonial" aria-controls="sw-testimonial-quotes">→</button>
        <button class="sw-label sw-testimonial-pause" type="button" data-testimonial-pause>Pause</button>
      </div>
    </section>
  </section>
  <script>
    import '../../scripts/swiss/testimonials.ts';
  </script>
</SwissLayout>
