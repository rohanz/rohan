---
import '../../styles/swiss-music.css';
import SwissLayout from '../../layouts/SwissLayout.astro';
import { SONGS } from '../../data/music';
import { MUSIC_DESCRIPTION } from '../../data/page-meta';
---
<SwissLayout title="music — rohan.jk" description={MUSIC_DESCRIPTION} section="music">
  <section class="sw-music">
    <header class="sw-music-rail">
      <div class="sw-music-rail-inner">
        <h1 class="sw-display sw-display-page" data-reveal="lines">music</h1>
        <span class="sw-label">{SONGS.length} releases</span>
        <div class="sw-music-legend sw-label" aria-label="Available on">
          <span>spotify</span><span>apple music</span><span>youtube</span>
        </div>
      </div>
    </header>
    <div class="sw-tracks" data-reveal-group>
      {SONGS.map((s) => (
        <div class="sw-track" data-reveal="block">
          <button class="sw-play" type="button" data-audio={s.audio} data-title={s.title} aria-pressed="false" aria-label={`Play preview of ${s.title}`}>
            <span class="sw-play-icon" aria-hidden="true"></span>
          </button>
          <div class="sw-track-main">
            <h2 class="sw-track-title">{s.title}</h2>
            <span class="sw-track-artist">{s.artist}</span>
          </div>
          <div class="sw-track-viz" aria-hidden="true">
            {['wave', 'freq', 'stereo', 'vu'].map((kind) => (
              <div class={`sw-meter sw-meter-${kind}`}>
                <canvas data-viz={kind}></canvas>
                <span class="sw-label">{kind}</span>
              </div>
            ))}
          </div>
          <div class="sw-track-links">
            <a class="sw-label sw-link-ext" href={s.spotifyUrl} target="_blank" rel="noopener noreferrer">spotify <span class="sw-arrow" aria-hidden="true">↗</span></a>
            <a class="sw-label sw-link-ext" href={s.appleMusicUrl} target="_blank" rel="noopener noreferrer">apple <span class="sw-arrow" aria-hidden="true">↗</span></a>
            <a class="sw-label sw-link-ext" href={s.youtubeUrl} target="_blank" rel="noopener noreferrer">youtube <span class="sw-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      ))}
    </div>
  </section>
  <script>
    import '../../scripts/swiss/music.ts';
  </script>
</SwissLayout>
