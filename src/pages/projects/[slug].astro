---
import SwissLayout from '../../layouts/SwissLayout.astro';
import { getCollection, render } from 'astro:content';
import { getProjectNav, type NavItem } from '../../lib/projectNav';
import { projectOgImage } from '../../lib/project-og';
import { cardTextFor } from '../../lib/swiss/card-text';
import { drawingFor, headerViewBoxFor } from '../../lib/swiss/drawings';
import '../../styles/swiss-cards.css';
import '../../styles/swiss-article.css';
import '../../styles/widget-base.css';
import '../../styles/bqst-widgets.css';
import '../../styles/chord-monitor.css';
import '../../styles/qla-widgets.css';
import '../../styles/qlf-widgets.css';
import '../../styles/demo-player.css';
import '../../styles/qla2-widgets.css';
import '../../styles/qls-widgets.css';
import '../../styles/mle-replay.css';
import '../../styles/room-run.css';
import '../../styles/swiss-widgets.css';
import { linkAttrs, projectLinks } from '../../lib/project-links';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const ordered = projects
    .filter((p) => !p.data.unlisted)
    .map((p) => ({ slug: p.id, title: p.data.title })) as NavItem[];
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, ordered } }));
}

const { project, ordered } = Astro.props;
const { Content, headings } = await render(project);
const { prev, next } = getProjectNav(ordered, project.id);
const word = cardTextFor(project.id);
const Drawing = drawingFor(project.id);
const h2h3 = headings.filter((h) => h.depth === 2 || h.depth === 3);
const firstH2 = h2h3.findIndex((h) => h.depth === 2);
const sections = firstH2 === -1 ? [] : h2h3.slice(firstH2);
---
<SwissLayout title={`${project.data.barTitle ? `${project.data.barTitle} · ` : ''}${project.data.title} — rohan.jk`} description={project.data.summary} section="projects" ogImage={projectOgImage(project.id)}>
  <header class="sw-article-head">
    <div class="sw-article-head-inner">
      <div class="sw-article-head-title">
        <a class="sw-label sw-link" href="/projects">projects</a>
        {project.data.award && <span class="sw-article-award sw-label" title={project.data.awardEvent}>{project.data.award}</span>}
        <h1 class="sw-article-word">{word ?? project.data.title}</h1>
        {word && <p class="sw-article-title">{project.data.title}</p>}
        <p class="sw-article-summary">{project.data.summary}</p>
        <div class="sw-article-meta">{project.data.technologies.map((t) => <span class="sw-label">{t}</span>)}</div>
        {project.data.links.length > 0 && <div class="sw-article-links">{projectLinks(project.data.links).map((link) => <a {...linkAttrs(link)}>{link.label}</a>)}</div>}
      </div>
      <div class="swiss-card sw-article-art" aria-hidden="true">
        <div class="swiss-card-art">
          {/* Centred per drawing: see headerViewBoxFor in lib/swiss/drawings.ts. */}
          {Drawing ? <Drawing viewBox={headerViewBoxFor(project.id)} /> : <div class="swiss-card-placeholder"></div>}
        </div>
      </div>
    </div>
  </header>
  <div class="sw-wrap sw-article-layout">
    <nav class="sw-toc train-toc" aria-label="section navigation">
      {sections.length > 0 && (
        <div class="toc-inner">
        <ol>
          {sections.map((h) => (
            <li class={h.depth === 3 ? 'sub' : ''} data-depth={h.depth}>
              <a href={`#${h.slug}`} data-target={h.slug}><span class="toc-label">{h.text}</span></a>
            </li>
          ))}
        </ol>
        </div>
      )}
      <div class="sw-toc-nav">
        {prev && <a class="sw-label sw-link" href={`/projects/${prev.slug}`}>← prev</a>}
        {next && <a class="sw-label sw-link" href={`/projects/${next.slug}`}>next →</a>}
        <a class="sw-label sw-link sw-toc-all" href="/projects">all projects</a>
      </div>
    </nav>
    {sections.length > 0 && <details class="sw-mobile-sections">
      <summary class="sw-label">sections</summary>
      <nav aria-label="Article sections">
        <ol>
          {sections.map((h) => <li class={h.depth === 3 ? 'sub' : ''}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>)}
        </ol>
      </nav>
    </details>}
    <article class="article">
      <Content />
      <nav class="sw-article-foot" aria-label="project navigation">
        <div class="sw-article-foot-cells">
          {prev ? <a class="prev" href={`/projects/${prev.slug}`}><span class="sw-label">← previous</span><span class="sw-article-foot-title">{prev.title}</span></a> : <div aria-hidden="true"></div>}
          {next ? <a class="next" href={`/projects/${next.slug}`}><span class="sw-label">next →</span><span class="sw-article-foot-title">{next.title}</span></a> : <div aria-hidden="true"></div>}
        </div>
        <a class="sw-article-all sw-label sw-link" href="/projects">all projects</a>
      </nav>
    </article>
  </div>
  <script>
    import '../../scripts/article.ts';
    import '../../scripts/article-widgets.ts';
    import { playDrawingOnArrival } from '../../lib/swiss/play-drawing';

    let cleanupSections: (() => void) | undefined;
    function initSections() {
      cleanupSections?.();
      const disclosure = document.querySelector<HTMLDetailsElement>('.sw-mobile-sections');
      if (!disclosure) return;
      const onClick = (event: MouseEvent) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        disclosure.open = false;
        history.replaceState({ ...history.state }, '', link.hash);
        target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      };
      disclosure.addEventListener('click', onClick);
      cleanupSections = () => disclosure.removeEventListener('click', onClick);
    }
    document.addEventListener('astro:page-load', initSections);
    document.addEventListener('astro:before-swap', () => { cleanupSections?.(); cleanupSections = undefined; });

    let cleanupArt: (() => void) | undefined;
    function initArt() {
      cleanupArt?.();
      const art = document.querySelector<HTMLElement>('.sw-article-art');
      cleanupArt = art ? playDrawingOnArrival(art) : undefined;
    }
    document.addEventListener('astro:page-load', initArt);
    document.addEventListener('astro:before-swap', () => { cleanupArt?.(); cleanupArt = undefined; });
  </script>
</SwissLayout>
