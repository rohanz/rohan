---
import SwissLayout from '../../layouts/SwissLayout.astro';
import SwissCard from '../../components/SwissCard.astro';
import SwissRailLinks from '../../components/SwissRailLinks.astro';
import { getCollection } from 'astro:content';
import { encodeFilter, visibleProjectFilters } from '../../data/project-filters';
// Dev shows unlisted drafts in the grid (marked) so they can be reviewed in
// place; production builds keep them URL-only.
const showUnlisted = import.meta.env.DEV;
const projects = (await getCollection('projects'))
  .filter((p) => showUnlisted || !p.data.unlisted)
  .sort((a, b) => a.data.order - b.data.order);
const filters = visibleProjectFilters(projects.flatMap((p) => p.data.technologies));
---
<SwissLayout ogImage="/assets/images/og/section-projects.png" title="projects - rohan.jk" description="Projects by rohan.jk — software, AI, audio, and data engineering builds." section="projects" hideFooter>
  <section class="sw-projects" aria-label="Projects">
    <aside class="sw-project-rail">
      <div class="sw-project-rail-inner">
        <div class="sw-rail-heading">
          <h1 class="sw-display sw-display-page" data-reveal="lines">projects</h1>
        </div>
        <div class="sw-filters" role="group" aria-label="Filter projects by technology">
          <button type="button" class="sw-filter sw-label" data-filter="all" aria-pressed="true" aria-controls="sw-project-grid">all</button>
          {filters.map((filter) => <button type="button" class="sw-filter sw-label" data-filter={encodeFilter(filter.match)} aria-pressed="false" aria-controls="sw-project-grid">{filter.label}</button>)}
        </div>
        <SwissRailLinks />
      </div>
    </aside>
    <div class="swiss-grid" id="sw-project-grid" data-reveal-group>
      {projects.map((p) => <SwissCard slug={p.id} title={p.data.title} summary={p.data.summary} technologies={p.data.technologies} unlisted={!!p.data.unlisted} award={p.data.award} awardEvent={p.data.awardEvent} />)}
    </div>
  </section>
  <script>
    import '../../scripts/swiss/tilt.ts';
    import '../../scripts/swiss/filters.ts';
  </script>
</SwissLayout>
