---
import Analytics from '../components/Analytics.astro';
import SwissThemeSwitch from '../components/SwissThemeSwitch.astro';
import { ClientRouter } from 'astro:transitions';
import { SOCIALS } from '../data/socials';
import { defaultPathFor } from '../lib/theme-paths';
import { DEFAULT_ACCENT } from '../lib/swiss/accents';
import '../styles/swiss.css';

interface Props {
  title: string;
  description: string;
  section?: 'home' | 'music' | 'projects' | 'about';
  ogImage?: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { title, description, section, ogImage, bodyClass = '', noindex = false } = Astro.props;
const canonical = new URL(defaultPathFor(Astro.url.pathname), Astro.site).href;
const ogAbs = new URL(ogImage ?? '/assets/images/og.png', Astro.site).href;
const isDefaultOg = ogImage === undefined;
const personLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Person',
  name: 'Rohan Kulshrestha', alternateName: 'rohan.jk', url: Astro.site?.href,
  jobTitle: 'Computer Engineering Student', sameAs: SOCIALS.map((s) => s.href),
});
const nav = [
  { id: 'home', label: 'home', href: '/swiss' },
  { id: 'projects', label: 'projects', href: '/swiss/projects' },
  { id: 'music', label: 'music', href: '/swiss/music' },
  { id: 'about', label: 'about', href: '/swiss/about' },
] as const;
---
<html lang="en" class:list={['theme-swiss', { 'sw-home': section === 'home' }]} style={`--accent:${DEFAULT_ACCENT.hex}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="author" content="rohan.jk" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="rohan.jk" />
    <meta property="og:image" content={ogAbs} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/GeneralSans-Variable.woff2" crossorigin />
    <!-- Chillax is font-display: optional; without a preload a cold load paints the nearest cached weight instead of these. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chillax-XESIRBQU62YFBC7YQZI6D2NT.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chillax-WZY5PMNTII6NKOB2TTIAX7QV.woff2" crossorigin />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={personLd} />
    <ClientRouter />
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a href="#sw-main" class="sr-only">Skip to content</a>
    <header class="sw-nav">
      <div class="sw-wrap sw-nav-inner">
        <a class="sw-wordmark" href="/swiss" aria-label="rohan.jk — home">rohan.jk</a>
        <nav class="sw-nav-links" aria-label="Primary">
          {nav.map((n) => <a class="sw-link" href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="sw-main"><slot /></main>
    <footer class="sw-footer">
      <div class="sw-wrap sw-footer-inner">
        <div class="sw-themes">
          {SOCIALS.map((s) => <a class="sw-label sw-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
        </div>
        <SwissThemeSwitch />
      </div>
    </footer>
    <script>
      import '../scripts/swiss/reveal.ts';
      import '../lib/theme-switch.ts';
    </script>
  </body>
</html>
