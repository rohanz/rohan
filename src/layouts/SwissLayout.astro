---
import Analytics from '../components/Analytics.astro';
import SwissThemeSwitch from '../components/SwissThemeSwitch.astro';
import { ClientRouter } from 'astro:transitions';
import { SOCIALS } from '../data/socials';
import { defaultPathFor } from '../lib/theme-paths';
import { DEFAULT_ACCENT } from '../lib/swiss/accents';
import '../styles/swiss.css';

interface Props {
  title: string;
  description: string;
  section?: 'home' | 'music' | 'projects' | 'about';
  ogImage?: string;
  bodyClass?: string;
  noindex?: boolean;
  /** Pages whose rails already carry the socials and theme switch drop the footer. */
  hideFooter?: boolean;
}
const { title, description, section, ogImage, bodyClass = '', noindex = false, hideFooter = false } = Astro.props;
const canonical = new URL(defaultPathFor(Astro.url.pathname), Astro.site).href;
const ogAbs = new URL(ogImage ?? '/assets/images/og.png', Astro.site).href;
const isDefaultOg = ogImage === undefined;
const personLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Person',
  name: 'Rohan Kulshrestha', alternateName: 'rohan.jk', url: Astro.site?.href,
  jobTitle: 'Computer Engineering Student', sameAs: SOCIALS.map((s) => s.href),
});
const nav = [
  { id: 'home', label: 'home', href: '/swiss' },
  { id: 'projects', label: 'projects', href: '/swiss/projects' },
  { id: 'music', label: 'music', href: '/swiss/music' },
  { id: 'about', label: 'about', href: '/swiss/about' },
] as const;
---
<html lang="en" class:list={['theme-swiss', { 'sw-home': section === 'home' }]} style={`--accent:${DEFAULT_ACCENT.hex}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="author" content="rohan.jk" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="rohan.jk" />
    <meta property="og:image" content={ogAbs} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/GeneralSans-Variable.woff2" crossorigin />
    <!-- Chillax is font-display: optional; without a preload a cold load paints the nearest cached weight instead of these. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chillax-WZY5PMNTII6NKOB2TTIAX7QV.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chillax-THF5L6EHVL4N4NNE3GYDZNZS.woff2" crossorigin />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={personLd} />
    <ClientRouter />
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a href="#sw-main" class="sr-only">Skip to content</a>
    <header class="sw-nav">
      <div class="sw-wrap sw-nav-inner">
        <a class="sw-wordmark" href="/swiss" aria-label="rohan.jk — home">rohan.jk</a>
        <nav class="sw-nav-links" aria-label="Primary">
          {nav.map((n) => <a class="sw-link" href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="sw-menu-toggle" type="button" aria-expanded="false" aria-controls="sw-mobile-menu">
          <span class="sw-menu-toggle-label">menu</span>
          <span class="sw-menu-toggle-mark" aria-hidden="true"></span>
        </button>
      </div>
      <div class="sw-mobile-menu" id="sw-mobile-menu" hidden>
        <nav class="sw-mobile-primary" aria-label="Mobile primary">
          {nav.map((n) => <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <SwissThemeSwitch />
      </div>
    </header>
    <main id="sw-main"><slot /></main>
    {!hideFooter && <footer class="sw-footer">
      <div class="sw-wrap sw-footer-inner">
        <div class="sw-themes">
          {SOCIALS.map((s) => <a class="sw-label sw-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
        </div>
        <SwissThemeSwitch />
      </div>
    </footer>}
    <script>
      import '../scripts/swiss/reveal.ts';
      import '../lib/theme-switch.ts';

      let cleanupNav: (() => void) | undefined;
      function initNav() {
        cleanupNav?.();
        const nav = document.querySelector<HTMLElement>('.sw-nav');
        if (!nav) return;
        const menuButton = nav.querySelector<HTMLButtonElement>('.sw-menu-toggle');
        const menu = nav.querySelector<HTMLElement>('.sw-mobile-menu');
        const compact = window.matchMedia('(max-width: 539px)');
        const setMenu = (open: boolean) => {
          if (!menuButton || !menu) return;
          menuButton.setAttribute('aria-expanded', String(open));
          menu.hidden = !open;
          nav.classList.toggle('is-menu-open', open);
        };
        const onMenuButton = () => setMenu(menuButton?.getAttribute('aria-expanded') !== 'true');
        const onMenuClick = (event: Event) => {
          if ((event.target as Element).closest('a')) setMenu(false);
        };
        const onKeydown = (event: KeyboardEvent) => {
          if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
            setMenu(false);
            menuButton.focus();
          }
        };
        const onCompactChange = () => { if (!compact.matches) setMenu(false); };
        menuButton?.addEventListener('click', onMenuButton);
        menu?.addEventListener('click', onMenuClick);
        document.addEventListener('keydown', onKeydown);
        compact.addEventListener('change', onCompactChange);
        // Arriving on the home page: land on the hero. The router's scroll reset and
        // the mandatory snap can race, which sometimes settled on selected work.
        const root = document.documentElement;
        if (root.classList.contains('sw-home') && !location.hash) {
          const prev = root.style.scrollSnapType;
          root.style.scrollSnapType = 'none';
          window.scrollTo({ top: 0, behavior: 'instant' });
          requestAnimationFrame(() => { root.style.scrollSnapType = prev; });
        }
        const phone = window.matchMedia('(max-width: 899px)');
        const update = () => nav.classList.toggle('is-visible',
          phone.matches || !document.documentElement.classList.contains('sw-home') || window.scrollY > 40);
        update();
        window.addEventListener('scroll', update, { passive: true });
        phone.addEventListener('change', update);
        // 'home' while already on the home page: back to the hero (a same-URL link does nothing by itself).
        const homeLinks = nav.querySelectorAll<HTMLAnchorElement>('a[href="/swiss"]');
        const onHome = (e: MouseEvent) => {
          if (document.documentElement.classList.contains('sw-home')) {
            e.preventDefault();
            setMenu(false);
            window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          }
        };
        homeLinks.forEach((home) => home.addEventListener('click', onHome));
        cleanupNav = () => {
          setMenu(false);
          window.removeEventListener('scroll', update);
          phone.removeEventListener('change', update);
          menuButton?.removeEventListener('click', onMenuButton);
          menu?.removeEventListener('click', onMenuClick);
          document.removeEventListener('keydown', onKeydown);
          compact.removeEventListener('change', onCompactChange);
          homeLinks.forEach((home) => home.removeEventListener('click', onHome));
        };
      }
      document.addEventListener('astro:page-load', initNav);
      document.addEventListener('astro:before-swap', () => { cleanupNav?.(); cleanupNav = undefined; });
      if (document.readyState !== 'loading') initNav();
      else document.addEventListener('DOMContentLoaded', initNav, { once: true });
    </script>
  </body>
</html>
